# MODELO — copie para brn_network.env localmente e preencha conforme sua rede.
# Nunca publique o segredo real. Se um segredo já foi publicado, rotacione-o em todos os nós.
BRN_NETWORK_SECRET=
BRN_NODE_PASSWORD=
BRN_WALLET_SESSION_PASS=

# API HTTP local do nó (usada pelo diagnóstico; não é o Tracker).
BRN_API_URL=http://127.0.0.1:5000
BRN_PEER_API_PORT=5000
BRN_HTTP_TIMEOUT=5

# Portas e descoberta P2P.
BRN_TRACKER_PORT=9000
BRN_TRACKER=
BRN_P2P_PORT=6001
BRN_BOOTSTRAP_PEERS=
