# ── 12. SEU_ENDERECO (opcional — auto-detecta se vazio) ─────────────
# Se o adnac tem Tailscale, descomente e ajuste com o IP do adnac:
# BRN_SEU_ENDERECO=100.XX.YY.ZZ:6001
# ═══════════════════════════════════════════════════════════════════
# PBFT — consenso bizantino de blocos (v9.5.0)
# ═══════════════════════════════════════════════════════════════════

# Liga o motor PBFT no nó. 0=desligado (multi-sig antigo), 1=ligado.
# Rollout: ligue primeiro no Origin, depois nos clientes.
BRN_PBFT_ENABLED=1

# Exige pbft_commits válidos em todo bloco recebido.
# SÓ ligue depois que TODOS os nós estiverem com ENABLED=1 e sincronizados.
# Se ligar antes, a chain trava.
BRN_PBFT_ENFORCE=0

# Timeout de cada rodada PBFT em segundos.
# 15s funciona para 4-7 validadores. Aumente se a latência entre
# máquinas for alta (ex: Tailscale com relay).
BRN_PBFT_TIMEOUT=15

# Limite de estados PBFT em memória (anti-leak). 100 é suficiente
# para rodadas pendentes sem estourar RAM.
BRN_PBFT_MAX_STATES=100
