# === MAQUINA 4 - CLIENTE / OBSERVER ===
# Copie BRN_NETWORK_SECRET do Windows origem (64 chars hex)

BRN_NETWORK_SECRET=<COLE_AQUI_O_SECRET_DO_WINDOWS_ORIGEM>

# Senhas próprias desta máquina (NÃO copiar do Windows)
BRN_NODE_PASSWORD=<gere_com_python_secrets_token_hex_24>
BRN_WALLET_SESSION_PASS=<gere_com_python_secrets_token_hex_24>
BRN_WEB_PASS=<gere_com_python_secrets_token_hex_12>

# Aponta para a ORIGEM (Windows principal)
BRN_BOOTSTRAP_PEERS=100.84.11.48:6001
BRN_POOL_URL=http://100.84.11.48:5000

# P2P local (porta diferente do Windows)
BRN_P2P_PORT=6002

# HTTP
BRN_WEB_HOST=0.0.0.0
BRN_WEB_PORT=5000
BRN_HTTPS=0

# Consistência
BRN_FORCE_DIFFICULTY=6

# Log
BRN_LOG_LEVEL=INFO
BRN_AUDIT_ENABLED=1