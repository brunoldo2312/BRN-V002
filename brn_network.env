# ============================================================
# brn_network.env — Configuração do Nó BRN (WINDOWS / CLIENTE)
# ============================================================

# ============================================================
# 1. SEGREDOS OBRIGATÓRIOS (O NÓ NÃO INICIA SEM ELES)
# ============================================================
# O BRN_NETWORK_SECRET DEVE SER IDÊNTICO AO DA ORIGEM
BRN_NETWORK_SECRET=088641fd110a36bcb3a1bd3d497d8cd68287bf10e49eedfc52d1fc0329ef8d12

# Troque pelas senhas que você usar nas carteiras dos clientes
BRN_NODE_PASSWORD=senha-cliente-aqui
BRN_WALLET_SESSION_PASS=senha-cliente-aqui
BRN_WEB_PASS=web-cliente-2026

# Endereço da carteira do cliente (opcional, pode deixar vazio)
BRN_TREASURY_ADDRESS=

# ============================================================
# 2. PAPEL DA REDE E CONSENSO
# ============================================================
BRN_IS_ORIGIN=0
BRN_POOL_ENABLED=0
BRN_ALLOW_SOLO_MINING=1

# Quórum Multi-Sig: 67% (Com 3 validadores, exigirá 3 assinaturas)
BRN_MAX_VALIDATORS=3
BRN_VALIDATOR_QUORUM=0.67
BRN_REQUIRE_ALL_SIGS=0

# ============================================================
# 3. DIFICULDADE
# ============================================================
BRN_MIN_DIFFICULTY=3
BRN_MAX_DIFFICULTY=6
BRN_DIFF_INTERVAL=6

# ============================================================
# 4. REDE, PORTAS E CONEXÕES
# ============================================================
BRN_P2P_PORT=6001
BRN_WEB_HOST=0.0.0.0
BRN_WEB_PORT=5000
BRN_EXPLORER_HOST=0.0.0.0
BRN_EXPLORER_PORT=8080
BRN_CORS_ORIGIN=*

# IP DA MÁQUINA (Tailscale ou LAN)
# Use o IP da máquina Windows onde este arquivo está
BRN_SEU_ENDERECO=100.84.11.48:6001

# APONTA PARA A ORIGEM (UBUNTU)
BRN_BOOTSTRAP_PEERS=100.111.253.8:6001

# ============================================================
# 5. COFRE BTC (OFFRAMP - BRN PARA BTC)
# ============================================================
BRN_BTC_NETWORK=testnet
BRN_BTC_RECEIVE_ADDRESS=
BRN_BTC_WIF=

# ============================================================
# 6. MULTI-SIG / BYPASS (ATIVA A PARTIR DA ALTURA 1500)
# ============================================================
BRN_SIG_COLLECT_TIMEOUT=60
BRN_BLOCK_SIG_TIMEOUT=5

# DEVE SER IDÊNTICO À ORIGEM
# Blocos 0..1499 pulam a assinatura. O bloco 1500 exige as 3 assinaturas.
BRN_BOOTSTRAP_SKIP_SIGS_UNTIL=1499
BRN_ASSUME_VALID_UNTIL=1499

BRN_ALLOW_LOCAL_BOOTSTRAP=1

# ============================================================
# 7. TRUST NETWORK
# ============================================================
BRN_TRUST_NODE_TTL=86400
BRN_TRUST_PROTECT_SCORE=200
BRN_TRUST_ACTIVE_TTL=3600

# ============================================================
# 8. LOGS / PERFORMANCE / SKIP
# ============================================================
BRN_LOG_LEVEL=INFO
BRN_AUDIT_ENABLED=1
BRN_AUDIT_LOG=audit.log
BRN_SKIP_VERIFY=1

# ============================================================
# 9. P2P TUNING
# ============================================================
BRN_SYNC_BATCH=50
BRN_SYNC_INTERVAL=5

# ============================================================
# 10. PBFT (CONSENSO BIZANTINO)
# ============================================================
BRN_PBFT_ENABLED=1
BRN_PBFT_ENFORCE=0
BRN_PBFT_TIMEOUT=15
BRN_PBFT_MAX_STATES=100

# Checkpoint automático (trava o hash na altura 5004)
BRN_CHECKPOINT_AUTO_HEIGHT=5004
# ============================================================
# 10. PBFT (CONSENSO BIZANTINO)
# ============================================================
BRN_PBFT_ENABLED=1
BRN_PBFT_ENFORCE=1
BRN_PBFT_START_HEIGHT=1500
BRN_PBFT_TIMEOUT=15
BRN_PBFT_MAX_STATES=100

# ============================================================
# 11. ENCODING
# ============================================================
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
