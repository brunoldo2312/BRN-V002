# 3) CONEXÃO COM A REDE (Apontando para o Ubuntu)
# IP do Tailscale do seu Ubuntu:
BRN_BOOTSTRAP_PEERS=100.111.253.8:6001
# Para o cliente conectar no Pool do Ubuntu:
BRN_POOL_URL=http://100.111.253.8:5000
BRN_POOL_ENABLED=1

# 4) CONSENSO MULTI-SIG (Evita que a rede trave)
# Como vocês são só 2 nós, exigir todos os votos (100%) é arriscado.
# Quorum de 50% permite que a rede continue funcionando se um nó cair.
BRN_REQUIRE_ALL_SIGS=0
BRN_VALIDATOR_QUORUM=0.51

# 5) P2P E PORTAS LOCAIS
BRN_P2P_PORT=6001
BRN_WEB_PORT=5000
BRN_EXPLORER_PORT=8080

# 6) CORREÇÃO DO AVISO "update_peers"
BRN_SEU_ENDERECO=127.0.0.1:6001

# 7) LOGS E DEBUG
BRN_LOG_LEVEL=INFO
BRN_P2P_AUTH=optional
BRN_P2P_AUTH_WINDOW=30
BRN_P2P_NONCE_CACHE=10000
BRN_BOOTSTRAP_SKIP_SIGS_UNTIL=300
