# ============================================================
# brn_network.env — Configuração do Nó BRN (WINDOWS / CLIENTE)
# v2.1 — 2026-11-09 (corrigido)
# ============================================================

# ============================================================
# 1. SEGREDOS OBRIGATÓRIOS (O NÓ NÃO INICIA SEM ELES)
# ============================================================
# O BRN_NETWORK_SECRET DEVE SER IDÊNTICO AO DA ORIGEM
BRN_NETWORK_SECRET=088641fd110a36bcb3a1bd3d497d8cd68287bf10e49eedfc52d1fc0329ef8d12

# [v13.9.3] main.py prefere BRN_PASSWORD; se vazio, cai para
# BRN_WALLET_SESSION_PASS, depois BRN_NODE_PASSWORD
BRN_PASSWORD=senha-cliente-aqui
BRN_NODE_PASSWORD=senha-cliente-aqui
BRN_WALLET_SESSION_PASS=senha-cliente-aqui

# URL do Origin (para /api/validator/announce)
BRN_POOL_URL=http://100.111.253.8:5000

# ============================================================
# 2. PAPEL DA REDE E CONSENSO
# ============================================================
BRN_IS_ORIGIN=0
BRN_POOL_ENABLED=0

# Quórum Multi-Sig: 2/3 (com 3 validadores)
# BRN_VALIDATOR_QUORUM=0.51 => required = ceil(3 * 0.51) = 2
BRN_MAX_VALIDATORS=3
BRN_VALIDATOR_QUORUM=0.51
BRN_REQUIRE_ALL_SIGS=0

# ============================================================
# 3. DIFICULDADE
# ============================================================
# Deve ser IDÊNTICO ao Origin
BRN_MIN_DIFFICULTY=3
BRN_MAX_DIFFICULTY=6
BRN_DIFF_INTERVAL=6

# ============================================================
# 4. REDE, PORTAS E CONEXÕES
# ============================================================
BRN_P2P_PORT=6001
BRN_WEB_HOST=0.0.0.0
BRN_WEB_PORT=5000
BRN_EXPLORER_HOST=0.0.0.0
BRN_EXPLORER_PORT=8080
BRN_CORS_ORIGIN=*

# IP desta máquina (Tailscale ou LAN) — DEVE ser único por nó
BRN_SEU_ENDERECO=100.84.11.48:6001

# Aponta para o Origin (Ubuntu)
BRN_BOOTSTRAP_PEERS=100.111.253.8:6001

# ============================================================
# 5. COFRE BTC (OFFRAMP — BRN → BTC)
# ============================================================
BRN_BTC_NETWORK=Mainnet
BRN_BTC_RECEIVE_ADDRESS=
BRN_BTC_WIF=

# ============================================================
# 6. MULTI-SIG / BOOTSTRAP
# ============================================================
# Tempo máximo para coletar assinaturas dos peers
BRN_SIG_COLLECT_TIMEOUT=15
BRN_BLOCK_SIG_TIMEOUT=5

# Bypass de multi-sig até a altura X. Blocos com h <= X pulam
# a exigência de 2/3 assinaturas. REMOVA (ou aumente) depois que
# a rede tiver múltiplos nós com SK ativa.
BRN_BOOTSTRAP_SKIP_SIGS_UNTIL=4300
BRN_ASSUME_VALID_UNTIL=4300

# ============================================================
# 7. TRUST NETWORK
# ============================================================
# TTL de "ativo" para quórum. Nós que não dão heartbeat há mais
# de X segundos NÃO contam para required. Reduzido de 3600 para
# 300 para eliminar fantasmas do trust.
BRN_TRUST_ACTIVE_TTL=300
BRN_TRUST_NODE_TTL=3600
BRN_TRUST_PROTECT_SCORE=500

# ============================================================
# 8. LOGS / PERFORMANCE / SKIP
# ============================================================
BRN_LOG_LEVEL=INFO
BRN_AUDIT_ENABLED=1
BRN_AUDIT_LOG=audit.log
BRN_SKIP_VERIFY=1

# ============================================================
# 9. P2P TUNING
# ============================================================
BRN_SYNC_BATCH=50
BRN_SYNC_INTERVAL=5

# ============================================================
# 10. PBFT (CONSENSO BIZANTINO)
# ============================================================
# ENABLED=1 liga o motor (propose/commit). ENFORCE=1 REJEITA
# blocos sem pbft_commits. Como a rede ainda está instável no
# multi-sig, mantemos ENFORCE=0. Ligue DEPOIS que todos os nós
# estiverem com SK ativa e co-assinando consistentemente.
BRN_PBFT_ENABLED=1
BRN_PBFT_ENFORCE=0
BRN_PBFT_START_HEIGHT=4300
BRN_PBFT_TIMEOUT=15
BRN_PBFT_MAX_STATES=100

# ============================================================
# 11. CHECKPOINT AUTOMÁTICO
# ============================================================
# Trava o hash do bloco X. DEVE SER IDÊNTICO ao Origin.
BRN_CHECKPOINT_AUTO_HEIGHT=5004

# ============================================================
# 12. ENCODING (Windows)
# ============================================================
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
