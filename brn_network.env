# ============================================================
# Multi-sig / Checkpoint
# ============================================================
# (dead code — não lida pelo blockchain.py atual; mantido por compat)
BRN_MULTISIG_START_HEIGHT=5020

# Alturas com checkpoint assinado manual (além do intervalo h % 1000)
BRN_CHECKPOINT_HEIGHTS=5001

# ============================================================
# brn_network.env — Configuração do Nó BRN (WINDOWS / CLIENTE)
# ============================================================

# ============================================================
# 1. SEGREDOS OBRIGATÓRIOS
# ============================================================
# ⚠️ CRÍTICO: BRN_NETWORK_SECRET DEVE SER IDÊNTICO AO DO UBUNTU.
# Se for diferente, auth_tag falha a partir da altura 6000.
BRN_NETWORK_SECRET=088641fd110a36bcb3a1bd3d497d8cd68287bf10e49eedfc52d1fc0329ef8d12

# ⚠️ Senhas locais — PEGUE DO SEU .env ATUAL DO WINDOWS.
# Trocar BRN_WALLET_SESSION_PASS = perder acesso à current_wallet.enc.
BRN_NODE_PASSWORD=senha-forte-windows-2026
BRN_WALLET_SESSION_PASS=carteira-windows-2026
BRN_WEB_PASS=web-windows-2026

# ============================================================
# 2. PAPEL DA REDE E CONSENSO
# ============================================================
# Windows é CLIENTE (não é Origin). Só o Ubuntu assina o trust_network.json.
BRN_IS_ORIGIN=0

# Pool e mineração solo: Windows é cliente por padrão.
# Ative via GUI ("Minerar Pool") ou CLI (--pool-client) quando quiser.
BRN_POOL_ENABLED=0
BRN_ALLOW_SOLO_MINING=0

# Quórum Multi-Sig — DEVE SER IGUAL AO UBUNTU (senão fork em 4006).
# Com MAX_VALIDATORS=3 e QUORUM=0.51 → required = ceil(3*0.51) = 2/3.
BRN_MAX_VALIDATORS=3
BRN_VALIDATOR_QUORUM=0.51
BRN_REQUIRE_ALL_SIGS=0

# ============================================================
# 3. DIFICULDADE (igual ao Ubuntu — consenso precisa bater)
# ============================================================
BRN_MIN_DIFFICULTY=3
BRN_MAX_DIFFICULTY=6
BRN_DIFF_INTERVAL=6

# ============================================================
# 4. REDE, PORTAS E CONEXÕES
# ============================================================
# Bootstrap: aponta para o Ubuntu (100.70.107.15) e o peer original.
# Se o IP do Ubuntu mudar, atualize aqui.
BRN_BOOTSTRAP_PEERS=100.70.107.15:6001,100.111.253.8:6001

# Redis: Windows normalmente NÃO tem Redis local. Deixe comentado.
# Se você instalar Redis no Windows, descomente a linha abaixo.
# BRN_REDIS_URL=redis://127.0.0.1:6379/0

# Workers uvicorn: no Windows, 4 workers pode ser instável (sem fork).
# Use 1 ou 2 para segurança.
BRN_UVICORN_WORKERS=1
ANYIO_THREAD_LIMIT=200

BRN_P2P_PORT=6001
BRN_WEB_HOST=0.0.0.0
BRN_WEB_PORT=5000
BRN_EXPLORER_HOST=0.0.0.0
BRN_EXPLORER_PORT=8080
BRN_CORS_ORIGIN=*

# Windows USA Tailscale (peer_addr 100.84.11.48 é Tailscale).
# Diferente do Ubuntu, que tem BRN_SKIP_TAILSCALE=1.
BRN_SKIP_TAILSCALE=0

# ============================================================
# 5. COFRE BTC (OFFRAMP - BRN PARA BTC)
# ============================================================
# Mantido testnet como o Ubuntu. Preencha WIF apenas se for usar offramp.
BRN_BTC_NETWORK=testnet
BRN_BTC_RECEIVE_ADDRESS=
BRN_BTC_WIF=
BRN_TREASURY_ADDRESS=brn1qxyzk7y0v2j4g0a8d9n5t2k7h4s6w8c9p2e

# ============================================================
# 6. CHECKPOINTS (igual ao Ubuntu)
# ============================================================
BRN_CHECKPOINT_INTERVAL=100
BRN_ORIGIN_PUBKEY=03c0f4604d5264b5eda409eac8212267bd76ff46973bb14e01a16c290f437e0e6e

# ============================================================
# 7. LOGS E PERFORMANCE
# ============================================================
BRN_LOG_LEVEL=INFO
BRN_AUDIT_ENABLED=1
BRN_SKIP_VERIFY=1
BRN_TCP_TIMEOUT=30.0

# Nota: BRN_REQUIRE_AUTH_TAG é dead code no blockchain.py atual
# (auth_tag é exigido sempre que há BRN_NETWORK_SECRET). Mantido
# por compat — NÃO altera comportamento.
BRN_REQUIRE_AUTH_TAG=0

# ============================================================
# 8. ASSUME-VALID + AUTO-CHECKPOINT (igual ao Ubuntu)
# ============================================================
# ⚠️ DEVE SER IGUAL AO UBUNTU. Se um expira em 4001 e outro em 5000,
# os nós se separam na validação completa.
BRN_ASSUME_VALID_UNTIL=5020
BRN_CHECKPOINT_AUTO_HEIGHT=5001
# Trust: TTL maior e score mínimo menor (protege os nós do prune)
BRN_TRUST_NODE_TTL=86400
BRN_TRUST_PROTECT_SCORE=200

# Coleta de sigs com timeout maior (peers lentos)
BRN_SIG_COLLECT_TIMEOUT=15
