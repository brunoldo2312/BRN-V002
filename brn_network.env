# ============================================================
# Multi-sig / Checkpoint (v9.4.7)
# ============================================================
# Multi-sig obrigatório a partir desta altura.
# Blocos abaixo: legado (sem sig). Blocos >= esta altura: exigem sig.
BRN_MULTISIG_START_HEIGHT=300

# Alturas com checkpoint assinado (lista separada por vírgula).
# Além do intervalo automático de 1000 blocos (h % 1000 == 0).
BRN_CHECKPOINT_HEIGHTS=32
